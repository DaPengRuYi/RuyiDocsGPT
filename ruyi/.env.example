# ================================================================
# RuyiDocsGPT 如意默认配置模板
# 用法: 复制到仓库根目录为 .env, 再把 API_KEY 换成你自己的硅基流动 key
#   Copy-Item .\ruyi\.env.example .\.env
# 注意: .env 已被 .gitignore 排除, 绝不要把真实 key 提交到 git!
# ================================================================

# ---- 大语言模型: 硅基流动(SiliconFlow), OpenAI 兼容端点 ----
LLM_PROVIDER=openai
LLM_NAME=Qwen/Qwen2.5-72B-Instruct
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# ↓↓↓ 换成你自己的硅基流动 key (sk-xxxx), 不要用别人的、不要提交到 git
API_KEY=<你的硅基流动_API_KEY>
VITE_API_STREAMING=true

# ---- Embedding: 本地 sentence-transformers, 中文优化, 512 维 ----
# 首次会自动从 HuggingFace 下载(直连即可; 若镜像下不动就用直连)
EMBEDDINGS_NAME=BAAI/bge-small-zh-v1.5

# ---- worker <-> backend 内部鉴权(随机字符串, 每套部署换一个) ----
INTERNAL_KEY=<随机_hex_例如_openssl_rand_hex_24>

# ---- 用户数据库: 本机 Postgres 隔离库(与其它真实库分开) ----
POSTGRES_URI=postgresql://docsgpt:docsgpt@127.0.0.1:5432/docsgpt
AUTO_CREATE_DB=true
AUTO_MIGRATE=true

# ---- Celery / 缓存: 本机 Redis, 用逻辑库 10/11/12 隔离(避开常用 0/1/2) ----
CELERY_BROKER_URL=redis://localhost:6379/10
CELERY_RESULT_BACKEND=redis://localhost:6379/11
CACHE_REDIS_URL=redis://localhost:6379/12

# ---- 向量库: 本地 FAISS(一源一索引, 文件存 indexes/) ----
VECTOR_STORE=faiss

# ---- 自托管模式 ----
# 本地开发: 无鉴权. 【重要】上公网/交付客户务必改成带鉴权(见 docs Deploying)
AUTH_TYPE=None
LOCAL_MODE_ADMIN=true
FLASK_DEBUG_MODE=true
VERSION_CHECK=false
